{
    "compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022", "ES2021.WeakRef"],

      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "rootDir": "./src",
      "outDir": "./dist",
      "declaration": true,
		"allowJs": true,
		"strict": false,
		"isolatedModules": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
      "types":[
       "node",
       "./src/global.d.ts"
      ]
    },
    "include": [
      "**/*.ts"
   ],
    "exclude": ["node_modules", "dist"]
  }
